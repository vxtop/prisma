{
  "name": "prisma",
  "version": "0.7.0",
  "description": "Prisma: a 3D interface for Claude on your own computer. Folders are cubes, programs float above them, and everything Claude looks at or changes happens in front of you.",
  "keywords": [
    "3d",
    "claude",
    "claude-code",
    "mcp",
    "visualization",
    "file-system",
    "observability",
    "three.js"
  ],
  "license": "Apache-2.0",
  "author": "virtuanista",
  "homepage": "https://vxtop.github.io/prisma/",
  "repository": { "type": "git", "url": "git+https://github.com/vxtop/prisma.git" },
  "bin": {
    "prisma": "server.js",
    "prisma-mcp": "mcp.js"
  },
  "files": [
    "server.js",
    "indexer.js",
    "mcp.js",
    "assistant.js",
    "pshost.ps1",
    "pickdirs.ps1",
    "prisma.vbs",
    "public",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs/guia.md",
    "docs/architecture.md",
    "docs/arquitectura.md",
    "docs/en/",
    "scripts/"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "node test/smoke.js",
    "test:e2e": "node test/e2e.js",
    "test:live": "node test/e2e.js --live",
    "check": "node --check server.js && node --check indexer.js && node --check mcp.js && node --check assistant.js && node --check scripts/dev.js",
    "demo": "node scripts/demo.js",
    "dev": "node scripts/dev.js"
  },
  "engines": {
    "node": ">=18.15"
  }
}
